{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/assets/preview.jpg",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        },
        {
          "key": "Content-Type",
          "value": "image/jpeg"
        }
      ]
    },
    {
      "source": "/assets/preview.png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/pitch",
      "destination": "/pitch/index.html"
    },
    {
      "source": "/pitch/",
      "destination": "/pitch/index.html"
    },
    {
      "source": "/((?!assets/|pitch/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
