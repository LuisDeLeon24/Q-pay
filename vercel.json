{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/pitch",
      "destination": "/pitch/index.html"
    },
    {
      "source": "/pitch/",
      "destination": "/pitch/index.html"
    },
    {
      "source": "/pitch/:path+",
      "destination": "/pitch/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
