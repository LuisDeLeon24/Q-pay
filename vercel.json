{
  "rewrites": [
    {
      "source": "/pitch",
      "destination": "/pitch/index.html"
    },
    {
      "source": "/pitch/",
      "destination": "/pitch/index.html"
    },
    {
      "source": "/pitch/:path+",
      "destination": "/pitch/index.html",
      "missing": [
        {
          "type": "filesystem"
        }
      ]
    },
    {
      "source": "/(.*)",
      "destination": "/index.html",
      "missing": [
        {
          "type": "filesystem"
        }
      ]
    }
  ]
}
